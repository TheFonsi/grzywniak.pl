OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional contract drafting model override. Empty uses OPENAI_MODEL.
OPENAI_CONTRACT_MODEL=
# Local automated tests only; real contract drafting uses OpenAI by default.
CONTRACT_AI_MOCK=false
PROJECT_AI_MOCK=false

# Agent infrastruktury: osobna GitHub App na serwerze wykonawcy, bez używania konta Codex agentów kodujących.
# Wymagane uprawnienia repozytorium: Administration (write), Contents (write).
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_ORG=Grzywniak
GITHUB_TEMPLATE_OWNER=Grzywniak
GITHUB_TEMPLATE_REPO=web-vite-template

# Planowane wdrożenia podglądu: token Cloudflare ograniczony do strefy DNS.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DNS_TOKEN=
PREVIEW_BASE_DOMAIN=preview.grzywniak.pl
PREVIEW_ORIGIN_HOST=
PRODUCTION_BASE_DOMAIN=app.grzywniak.pl
PRODUCTION_ORIGIN_HOST=
VPS_CONTROL_URL=
VPS_CONTROL_TOKEN=
PUBLIC_SITE_URL=https://grzywniak.pl
CODEX_RUNNER_URL=
CODEX_RUNNER_TOKEN=
AGENT_MAX_CONCURRENCY=2
AGENT_TASK_TIMEOUT_MIN=60
AGENT_TASK_COST_LIMIT_PLN=50
AGENT_MONTHLY_LIMIT_PLN=2000
PROJECT_DEFAULT_COST_LIMIT_PLN=500
# Where completed project briefs are delivered. Defaults to CONTACT_TO, then dawid@grzywniak.pl.
DISCOVERY_TO=dawid@grzywniak.pl
# Required by PHP mail() on production hosting.
CONTACT_FROM=dawid@grzywniak.pl
# Required to open /api/admin.php. Use a strong, unique password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Automatically remove non-archived conversation files older than this many days.
DISCOVERY_RETENTION_DAYS=90
# Set to true locally to use a deterministic, free discovery reply.
DISCOVERY_MOCK=false
# Default commercial rules for draft offers. All amounts are net PLN.
OFFER_HOURLY_RATE_NET=150
OFFER_VAT_RATE=23
OFFER_DEPOSIT_UP_TO_5000=10
OFFER_DEPOSIT_UP_TO_10000=20
OFFER_DEPOSIT_UP_TO_30000=30
OFFER_DEPOSIT_ABOVE_30000=50
